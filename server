#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$project_root"

socket_path="${FEARLESS_CONSPIRACY_SOCKET:-/tmp/fearless-conspiracy.sock}"
strict_users=0
server_args=()
interactive_default=0
if (( $# == 0 )) && [[ -t 0 ]]; then
  interactive_default=1
fi

usage() {
  cat <<'EOF'
Usage: ./server [options]

With no options in a terminal, asks questions to set up the lobby.
Noninteractive defaults: /tmp/fearless-conspiracy.sock, 5 players,
randomized roles, normal timers, same-UID clients allowed.

Wrapper options:
  --socket PATH       Use another socket path.
  --strict-users      Require a different Linux UID for every player.
  --shared-local      Let any local Linux user connect to the game socket.

Game options:
  --setup             Ask setup questions; other flags supply defaults.
  --players NUMBER    Choose 3 through 9 players without setup questions.
  --scenario          Assign roles in predictable preset order.
  --manual            Advance phases with the server command "advance".
  --fast              Use short automatic timers.
  --preset PRESET     demo3, standard4, demo5, standard6, standard7,
                      standard8, or full9.
  --duration P=S      Override a phase duration.
EOF
}

while (( $# )); do
  case "$1" in
    --socket)
      [[ $# -ge 2 ]] || { printf '%s\n' '--socket requires a path' >&2; exit 2; }
      socket_path="$2"
      shift 2
      ;;
    --socket=*)
      socket_path="${1#*=}"
      shift
      ;;
    --strict-users)
      strict_users=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      server_args+=("$1")
      shift
      ;;
  esac
done

if (( ! strict_users )); then
  server_args+=(--allow-same-uid)
fi

if (( interactive_default )); then
  server_args+=(--setup)
fi

cargo build --quiet --bin fearless-conspiracy-server
exec target/debug/fearless-conspiracy-server "$socket_path" "${server_args[@]}"
