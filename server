#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$project_root"

socket_path="${FEARLESS_CONSPIRACY_SOCKET:-/tmp/fearless-conspiracy.sock}"
strict_users=0
server_args=()

usage() {
  cat <<'EOF'
Usage: ./server [options]

Local defaults: /tmp/fearless-conspiracy.sock, Demo 5, same-UID clients allowed.

Wrapper options:
  --socket PATH       Use another socket path.
  --strict-users      Require a different Linux UID for every player.
  --shared-local      Let any local Linux user connect to the game socket.

Game options:
  --scenario          Assign roles in predictable preset order.
  --manual            Advance phases with the server command "advance".
  --fast              Use short automatic timers.
  --preset PRESET     demo5, standard7, standard8, or full9.
  --duration P=S      Override a phase duration.
EOF
}

while (( $# )); do
  case "$1" in
    --socket)
      [[ $# -ge 2 ]] || { printf '%s\n' '--socket requires a path' >&2; exit 2; }
      socket_path="$2"
      shift 2
      ;;
    --socket=*)
      socket_path="${1#*=}"
      shift
      ;;
    --strict-users)
      strict_users=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      server_args+=("$1")
      shift
      ;;
  esac
done

if (( ! strict_users )); then
  server_args+=(--allow-same-uid)
fi

cargo build --quiet --bin fearless-conspiracy-server
exec target/debug/fearless-conspiracy-server "$socket_path" "${server_args[@]}"
